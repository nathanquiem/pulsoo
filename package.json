{
  "name": "pulsoo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server/index.js",
    "db:migrate": "tsx server/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.2",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "lucide-react": "1.67.0",
    "openai": "7.47.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
