# Copie para .env. Nunca versionar valores reais.
NODE_ENV=development
HOST=127.0.0.1
PORT=3081
APP_URL=http://localhost:3081
DEMO_MODE=true
STORAGE_DRIVER=file
DATABASE_URL=
SESSION_SECRET=
ADMIN_EMAIL=admin@pulsoo.local
ADMIN_PASSWORD=
CENTRAL_BASE_URL=
CENTRAL_EMPRESA_ID=
CENTRAL_API_KEY=
CENTRAL_WEBHOOK_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_MODEL_SUMMARY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ASSEMBLYAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
CALCOM_API_KEY=
CALCOM_API_VERSION_SLOTS=2024-09-04
CALCOM_API_VERSION_BOOKINGS=2024-08-13
APPROVAL_WEBHOOK_URL=
# Produção exige DEMO_MODE=false, STORAGE_DRIVER=postgres, HTTPS no proxy,
# SESSION_SECRET >= 32 caracteres e ADMIN_PASSWORD >= 12 caracteres.

# Somente para Docker/VPS; valores diferentes e sem caracteres reservados na URL.
POSTGRES_PASSWORD=
PULSOO_DB_PASSWORD=

# Canal confirmado: evolution ou official; vazio bloqueia follow-up real sem origem conhecida.
CENTRAL_CHANNEL_MODE=
# Opcional se contato/conversa já tem responsável ativo.
CENTRAL_FOLLOWUP_RESPONSAVEL_ID=

# Limites por turno: consultas a especialistas, caracteres de histórico e tokens de saída.
AGENT_MAX_DELEGATIONS=1
AGENT_CONTEXT_CHARS=24000
AGENT_MAX_OUTPUT_TOKENS=700

# Somente após publicar/homologar o contrato docs/PROMPT-CENTRAL-ATENDIMENTO.md
CENTRAL_ATENDIMENTO_V1=false

# Aviso humano HTTPS: segredo compartilhado de pelo menos 32 caracteres; runtime apenas.
HUMAN_NOTIFICATION_WEBHOOK_URL=
HUMAN_NOTIFICATION_WEBHOOK_SECRET=
